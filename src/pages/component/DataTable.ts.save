
import { Locator, expect } from '@playwright/test';

export class DataTable {
    constructor(
        private table: Locator,
        private pagination: Locator,
        private nextPageButton: Locator,
        private previousPageButton: Locator
    ) {}

    // Normalize values for consistent row matching.
    private normalize(value: string): string {
        return value
            .replace(/[_-]/g, '-')
            .replace(/\s+/g, ' ')
            .trim()
            .toLowerCase();
    }

    // Get the index of a column using its header name.
    async getColumnIndex(columnName: string): Promise<number> {
        const headers = this.table.locator('thead th');

        const header = headers
            .filter({ hasText: columnName })
            .first();

        return await header.evaluate((element) =>
            Array.from(element.parentElement!.children).indexOf(element)
        );
    }

    // Get a cell value for a row on the current page.
    async getCellValue(
        rowValue: string,
        rowColumn: string,
        targetColumn: string
    ): Promise<string> {
        const rowColumnIndex = await this.getColumnIndex(rowColumn);
        const targetColumnIndex = await this.getColumnIndex(targetColumn);

        const rows = this.table.locator('tbody tr');
        const expectedValue = this.normalize(rowValue);
        const rowCount = await rows.count();

        for (let i = 0; i < rowCount; i++) {
            const row = rows.nth(i);
            const cell = row.locator('td').nth(rowColumnIndex);
            const links = cell.locator('a');
            const linkCount = await links.count();

            // Match the cluster-name link, not avatar initials.
            for (let j = 0; j < linkCount; j++) {
                const actualValue = this.normalize(
                    await links.nth(j).innerText()
                );

                if (actualValue === expectedValue) {
                    return (
                        await row
                            .locator('td')
                            .nth(targetColumnIndex)
                            .innerText()
                    ).trim();
                }
            }
        }

        throw new Error(
            `Row '${rowValue}' was not found in column '${rowColumn}'.`
        );
    }

    // Check whether a row exists on the current page only.
    async hasRow(
        rowValue: string,
        rowColumn: string
    ): Promise<boolean> {
        const rowColumnIndex = await this.getColumnIndex(rowColumn);

        const rows = this.table.locator('tbody tr');
        const expectedValue = this.normalize(rowValue);
        const rowCount = await rows.count();

        for (let i = 0; i < rowCount; i++) {
            const cell = rows
                .nth(i)
                .locator('td')
                .nth(rowColumnIndex);

            const links = cell.locator('a');
            const linkCount = await links.count();

            for (let j = 0; j < linkCount; j++) {
                const actualValue = this.normalize(
                    await links.nth(j).innerText()
                );

                if (actualValue === expectedValue) {
                    return true;
                }
            }
        }

        return false;
    }

    // Read the current pagination range.
    async getPaginationRange(): Promise<string> {
        const text = await this.pagination.innerText();
        return text.replace(/\s+/g, ' ').trim();
    }

    // Move to the next page, if another page exists.
   
// Move to the next page, if another page exists.

async goToNextPage(): Promise<void> {
    const paginationBefore = await this.getPaginationRange();

    const match = paginationBefore.match(
        /(\d+)\s*-\s*(\d+)\s+of\s+(\d+)/
    );

    if (!match) {
        throw new Error(
            `Unable to determine pagination state: "${paginationBefore}".`
        );
    }

    const currentStart = Number(match[1]);
    const currentEnd = Number(match[2]);
    const total = Number(match[3]);

    if (total === 0 || currentEnd >= total) {
        throw new Error(
            `Cannot navigate next: already on the last page (${paginationBefore}).`
        );
    }

    await expect(this.nextPageButton).toBeVisible();
    await expect(this.nextPageButton).toBeEnabled();

    await this.nextPageButton.click();

    await expect.poll(
        async () => {
            const currentPagination = await this.getPaginationRange();
            const currentMatch = currentPagination.match(
                /(\d+)\s*-\s*(\d+)\s+of\s+(\d+)/
            );

            if (!currentMatch) {
                return false;
            }

            const newStart = Number(currentMatch[1]);
            const newTotal = Number(currentMatch[3]);

            return newStart > currentStart && newTotal === total;
        },
        {
            message: `Pagination should advance beyond "${paginationBefore}"`,
            timeout: 5000,
            intervals: [250, 500, 1000]
        }
    ).toBe(true);
}


// Return to the first page.
async goToFirstPage(): Promise<void> {
    while (true) {
        const paginationBefore = await this.getPaginationRange();

        const match = paginationBefore.match(
            /(\d+)\s*-\s*(\d+)\s+of\s+(\d+)/
        );

        if (!match) {
            throw new Error(
                `Unable to determine pagination state: "${paginationBefore}".`
            );
        }

        const currentStart = Number(match[1]);

        if (currentStart === 1) {
            return;
        }

        await expect(this.previousPageButton).toBeVisible();
        await expect(this.previousPageButton).toBeEnabled();

        await this.previousPageButton.click();

        await expect.poll(
            () => this.getPaginationRange(),
            {
                message: `Pagination should move back from ${paginationBefore}`,
                timeout: 10000,
                intervals: [250, 500, 1000]
            }
        ).not.toBe(paginationBefore);
    }
}


    // Find a row across pages and return the target cell value.
    async findCellValueAcrossPage        rowValue: string,
        rowColumn: string,
        targetColumn: string
    ): Promise<string> {
        await this.goToFirstPage();

        while (true) {
            try {
                return await this.getCellValue(
                    rowValue,
                    rowColumn,
                    targetColumn
                );
            } catch (error) {
                if (
                    !(error instanceof Error) ||
                    !error.message.includes('was not found in column')
                ) {
                    throw error;
                }

                const paginationText = await this.getPaginationRange();

                const match = paginationText.match(
                    /(\d+)\s*-\s*(\d+)\s+of\s+(\d+)/
                );

                if (!match) {
                    throw new Error(
                        `Unable to determine pagination state: "${paginationText}".`
                    );
                }

                const currentEnd = Number(match[2]);
                const total = Number(match[3]);

                if (total === 0 || currentEnd >= total) {
                    throw error;
                }

                await this.goToNextPage();
            }
        }
    }

    // Check whether a row exists anywhere in the paginated table.
    async hasRowAcrossPages(
        rowValue: string,
        rowColumn: string
    ): Promise<boolean> {
        await this.goToFirstPage();

        while (true) {
            const exists = await this.hasRow(rowValue, rowColumn);

            if (exists) {
                return true;
            }

            const paginationText = await this.getPaginationRange();

            const match = paginationText.match(
                /(\d+)\s*-\s*(\d+)\s+of\s+(\d+)/
            );

            if (!match) {
                throw new Error(
                    `Unable to determine pagination state: "${paginationText}".`
                );
            }

            const currentEnd = Number(match[2]);
            const total = Number(match[3]);

            // Stop after checking the last page.
            if (total === 0 || currentEnd >= total) {
                return false;
            }

            await this.goToNextPage();
        }
    }
}
